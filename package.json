{
  "name": "vs-code-react-pr-reviewer",
  "displayName": "VS Code React PR Reviewer",
  "description": "AI-Powered React PR Reviewer",
  "version": "0.0.5",
  "publisher": "react-team",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsrajandavid/vs-code-react-pr-reviewer"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "react-reviewer-view-container",
          "title": "React Reviewer",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "react-reviewer-view-container": [
        {
          "type": "webview",
          "id": "react-reviewer-sidebar",
          "name": "Branch Manager"
        }
      ]
    },
    "commands": [
      {
        "command": "react-review.auditFile",
        "title": "ReactReview: Audit File"
      },
      {
        "command": "reviewer.updateApiKey",
        "title": "ReactReview: Update API Key"
      },
      {
        "command": "reviewer.testApiKey",
        "title": "ReactReview: Test API Key"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --production",
    "esbuild-base": "node build.js",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.27.2",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1"
  }
}