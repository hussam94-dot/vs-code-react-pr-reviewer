{
  "name": "codehawk-ai",
  "displayName": "CodeHawk AI",
  "description": "Sharp-eyed AI code review assistant. Catch bugs, security issues, and performance problems before they fly into production.",
  "version": "0.0.10",
  "publisher": "RajanDavid",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsrajandavid/vs-code-react-pr-reviewer"
  },
  "icon": "media/shield128x128.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "AI",
    "code review",
    "gemini",
    "react",
    "audit",
    "security"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "react-reviewer-view-container",
          "title": "CodeHawk AI",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "react-reviewer-view-container": [
        {
          "type": "webview",
          "id": "react-reviewer-sidebar",
          "name": "CodeHawk Manager"
        }
      ]
    },
    "commands": [
      {
        "command": "react-review.auditFile",
        "title": "CodeHawk: Audit File"
      },
      {
        "command": "reviewer.updateApiKey",
        "title": "CodeHawk: Update API Key"
      },
      {
        "command": "reviewer.testApiKey",
        "title": "CodeHawk: Test API Key"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --production",
    "esbuild-base": "node build.js",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "esbuild": "^0.27.2",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1"
  }
}